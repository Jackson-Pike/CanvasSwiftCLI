{"nodes": [{"id": "docs_superpowers_specs_2026_06_25_swiftui_app_design_spec", "label": "SwiftUI macOS Menu Bar App Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-25-swiftui-app-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Jackson Pike", "contributor": null}, {"id": "docs_superpowers_specs_2026_06_25_swiftui_app_design_canvascore", "label": "CanvasCore library", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-25-swiftui-app-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Jackson Pike", "contributor": null, "rationale": "Business logic extracted into a local Swift Package library so the SwiftUI presentation layer stays thin and the logic is independently testable; the CLI (MyTool) was retired in the same move"}, {"id": "docs_superpowers_specs_2026_06_25_swiftui_app_design_apiclient", "label": "APIClient", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-25-swiftui-app-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Jackson Pike", "contributor": null, "rationale": "Single struct owning all URLSession calls against https://byuh.instructure.com/api/v1 with Bearer token auth and convertFromSnakeCase decoding; the only networking surface in the codebase"}, {"id": "docs_superpowers_specs_2026_06_25_swiftui_app_design_gradecalculator", "label": "GradeCalculator", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-25-swiftui-app-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Jackson Pike", "contributor": null, "rationale": "Pure grade math (no UI, no API) \u2014 weighted/unweighted current grade, per-group breakdown, Canvas drop rules (drop_lowest/drop_highest/never_drop) applied automatically in groupPercent()"}, {"id": "docs_superpowers_specs_2026_06_25_swiftui_app_design_solvefortarget", "label": "solveForTarget target-grade solver", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-25-swiftui-app-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Jackson Pike", "contributor": null, "rationale": "Binary search over a uniform score X in [0,100] instead of a closed-form inverse, because it handles weighted and unweighted courses uniformly and respects drop rules for free by reusing the existing groupPercent() path; returns alreadyAchieved / needed(percent) / impossible(maxPossible)"}, {"id": "docs_superpowers_specs_2026_06_25_swiftui_app_design_byuhdefaultscale", "label": "byuhDefaultScale grading scale", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-25-swiftui-app-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Jackson Pike", "contributor": null, "rationale": "Official BYUH scale (A>=94 ... F>=0) used as fallback; per-course Canvas grading_scheme (fractions 0-1, multiplied by 100) overrides it when present"}, {"id": "docs_superpowers_specs_2026_06_25_swiftui_app_design_menubarextra_app", "label": "MenuBarExtra popover app shell", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-25-swiftui-app-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Jackson Pike", "contributor": null, "rationale": "380x520 popover from a menu-bar graduation cap icon (macOS 13+ MenuBarExtra, LSUIElement hides the dock icon); no background polling \u2014 personal tool, manual refresh is sufficient"}, {"id": "docs_superpowers_specs_2026_06_25_swiftui_app_design_keychain_token_storage", "label": "Keychain API token storage", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-25-swiftui-app-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Jackson Pike", "contributor": null, "rationale": "Token stored only in macOS Keychain via the Security framework; on