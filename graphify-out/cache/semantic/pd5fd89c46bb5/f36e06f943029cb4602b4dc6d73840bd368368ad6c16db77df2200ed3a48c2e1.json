{"nodes": [{"id": "docs_superpowers_specs_2026_06_26_keychain_onboarding_design_spec", "label": "Keychain Onboarding UX Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-26-keychain-onboarding-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_26_keychain_onboarding_design_keychainwarningview", "label": "KeychainWarningView interstitial", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-26-keychain-onboarding-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The macOS Keychain dialog was appearing before any in-app UI and referenced the alarming internal identifier canvas_token; this interstitial defers all Keychain access until the user taps Continue (acknowledgeKeychain()), and AppState loads the token lazily instead of eagerly on launch"}, {"id": "docs_superpowers_specs_2026_06_26_keychain_onboarding_design_keychain_upsert_save", "label": "Keychain upsert save pattern", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-26-keychain-onboarding-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SecItemDelete + SecItemAdd could trigger two system prompts in quick succession; replaced with SecItemUpdate falling back to SecItemAdd on errSecItemNotFound, plus friendly kSecAttrLabel ('Canvas Grades \u2013 API Token') and kSecAttrDescription metadata so the system dialog is less alarming"}], "edges": [{"source": "docs_superpowers_specs_2026_06_26_keychain_onboarding_design_spec", "target": "docs_superpowers_specs_2026_06_26_keychain_onboarding_design_keychainwarningview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-26-keychain-onboarding-design.md", "sour