{"nodes": [{"id": "docs_superpowers_specs_2026_06_22_phase2_design_spec", "label": "Phase 2 Design Spec (CLI + TUI)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-22-phase2-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Jackson Pike", "contributor": null}, {"id": "docs_superpowers_specs_2026_06_22_phase2_design_gradeditem", "label": "GradedItem join struct", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-22-phase2-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Jackson Pike", "contributor": null, "rationale": "Flat join of Assignment + Submission so grade math operates on one shape; earnedPoints nil means ungraded, whatIfPoints overrides earned when set"}, {"id": "docs_superpowers_specs_2026_06_22_phase2_design_what_if_calculator", "label": "What-If Grade Calculator modes", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-22-phase2-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Jackson Pike", "contributor": null, "rationale": "Three composable modes (per-item what-if, blanket score on ungraded, perfect remaining); composability works because blanket only touches items where both earnedPoints and whatIfPoints are nil, so later per-item overrides are preserved"}, {"id": "docs_superpowers_specs_2026_06_22_phase2_design_weighted_grade_math", "label": "Weighted grade math (active groups normalization)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-22-phase2-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Jackson Pike", "contributor": null, "rationale": "Weighted grade divides by the sum of active group weights (groups with at least one graded item) so ungraded categories do not drag the grade down; weighted vs unweighted detected per-course via applyAssignmentGroupWeights"}, {"id": "docs_superpowers_specs_2026_06_22_phase2_design_tui", "label": "Raw-mode terminal TUI", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-22-phase2-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Jackson Pike", "contributor": null, "rationale": "termios raw mode with arrow-key escape sequences and ANSI rendering; risk flagged on Darwin c_cc tuple indices for VMIN/VTIME"}], "edges": [{"source": "docs_superpowers_specs_2026_06_22_phase2_design_spec", "target": "docs_superpowers_specs_2026_06_22_phase2_design_gradeditem", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-22-phase2-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_22_phase2_design_spec", "target": "docs_superpowers_specs_2026_06_22_phase2_design_what_if_calculator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-22-phase2-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_22_phase2_design_spec", "target": "docs_superpowers_specs_2026_06_22_phase2_design_weighted_grade_math", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-22-phase2-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_22_phase2_design_spec", "target": "docs_superpowers_specs_2026_06_22_phase2_design_tui", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-22-phase2-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_22_phase2_design_what_if_calculator", "target": "docs_superpowers_specs_2026_06_22_phase2_design_gradeditem", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/